#include "knobgoblin_nrf52840-layouts.dtsi"
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    matrix_transform0: matrix_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <5>;
        map = <
                    RC(0,1) RC(0,2) RC(0,3) RC(0,4)
                    RC(1,1) RC(1,2) RC(1,3) RC(1,4)
                    RC(2,1) RC(2,2) RC(2,3) RC(2,4)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)
        >;
    };

    encoder0: encoder0 {
      compatible = "alps,ec11";
      a-gpios = <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
      b-gpios = <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
      steps = <96>;
      status = "okay";
  };

  encoder1: encoder1 {
      compatible = "alps,ec11";
      a-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
      b-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
      steps = <96>;
      status = "okay";
  };

  sensors: sensors {
      compatible = "zmk,keymap-sensors";
      sensors = <&encoder0 &encoder1>;
      triggers-per-rotation = <24>;
  };
};

&physical_layout_knobgoblin_nrf52840 {
    transform = <&matrix_transform0>;
};
