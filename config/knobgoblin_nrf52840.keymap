#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
                        
        kg_ht: kg_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        
        to_ht: to_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&to>, <&to>;
        };
    };
    
    keymap {
        compatible = "zmk,keymap";

        layer_macropad {
            display-name = "Macropad";
            bindings = <
                                    &kg_ht LS(LG(N3)) LS(LC(LG(N3)))    &kg_ht LS(LG(N4)) LS(LC(LG(N4)))    &kp LS(LG(N5))    &kp BACKSLASH
                                    &kp LG(C)                           &kp LG(V)                           &kp BACKSPACE     &kp DELETE
                                    &kp LG(Z)                           &kp LA(LEFT)                        &kp INSERT        &kp LA(RIGHT)
                &kp C_PLAY_PAUSE    &kp TILDE                           &kp PAGE_DOWN                       &kp UP            &kp PAGE_UP
                &kp C_MUTE          &to_ht 2 1                          &kp LEFT                            &kp DOWN          &kp RIGHT
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp RIGHT LEFT>;
        };

        layer_numpad {
            display-name = "Numpad";
            bindings = <
                          &kp LPAR     &kp RPAR    &kp CARET    &kp SLASH
                          &kp N7       &kp N8      &kp N9       &kp STAR
                          &kp N4       &kp N5      &kp N6       &kp MINUS
                &trans    &kp N1       &kp N2      &kp N3       &kp PLUS
                &trans    &to_ht 2 0   &kp N0      &kp DOT      &kp ENTER
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp RIGHT LEFT>;
        };

        layer_system {
            display-name = "System";
            bindings = <
                               &bt BT_SEL 0      &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3
                               &out OUT_TOG      &none           &none           &none
                               &studio_unlock    &none           &none           &none
                &sys_reset     &studio_unlock    &none           &none           &none
                &bootloader    &to_ht 1 0        &none           &none           &bt BT_CLR
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp RIGHT LEFT>;
        };

        layer_reserved { status = "reserved"; };
    };
};
