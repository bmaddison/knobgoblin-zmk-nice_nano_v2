#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>

#define kgbase 0
#define kgnumpad 1
#define kgsystem 2
#define kgreserved 3

/ {
    behaviors {
        to_1_or_2: to_1_or_2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&to kgnumpad>, <&to kgsystem>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        to_0_or_2: to_0_or_2 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&to kgbase>, <&to kgsystem>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };
    
    keymap {
        compatible = "zmk,keymap";

        kgbase {
            display-name = "Macropad";
            bindings = <
                                  &kp LS(LG(N3))  &kp LS(LG(N4))  &kp LS(LG(N5))  &kp BACKSLASH
                                  &kp LG(C)       &kp LG(V)       &kp BACKSPACE   &kp DELETE
                                  &kp LG(Z)       &kp LA(LEFT)    &kp INSERT      &kp RA(RIGHT)
                &kp C_PLAY_PAUSE  &kp TILDE       &kp PAGE_DOWN   &kp UP          &kp PAGE_UP
                &kp C_MUTE        &to_1_or_2      &kp LEFT        &kp DOWN        &kp RIGHT
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp RIGHT LEFT>;
        };

        kgnumpad {
            display-name = "Numpad";
            bindings = <
                        &kp LPAR    &kp RPAR  &kp CARET  &kp SLASH
                        &kp N7      &kp N8    &kp N9     &kp STAR
                        &kp N4      &kp N5    &kp N6     &kp MINUS
                &trans  &kp N1      &kp N2    &kp N3     &kp PLUS
                &trans  &to_0_or_2  &kp N0    &kp DOT    &kp ENTER
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp RIGHT LEFT>;
        };

        kgsystem {
            display-name = "System";
            bindings = <
                              &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3
                              &out OUT_TOG    &none           &none           &none
                              &studio_unlock  &studio_unlock  &studio_unlock  &studio_unlock
                &sys_reset    &none           &none           &none           &none
                &bootloader   &to kgbase      &to kgnumpad    &none           &bt BT_CLR
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp RIGHT LEFT>;
        };

        kgreserved { status = "reserved"; };
    };
};

